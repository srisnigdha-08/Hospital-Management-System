# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital_management
DB_USER=root
DB_PASSWORD=change-me
DB_LOGGING=false

# JWT (In production, both secrets are required, must be at least 32 characters, distinct, and cannot use default placeholders)
JWT_ACCESS_SECRET=replace-with-a-random-string-at-least-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-string-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Password reset
PASSWORD_RESET_EXPIRES_MIN=30

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Email (stubbed — see src/services/email.service.js).
# Swap in a real provider (SendGrid, SES, SMTP) for production.
EMAIL_FROM=no-reply@hms.test
