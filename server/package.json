{
  "name": "hms-server",
  "version": "1.0.0",
  "description": "Hospital Management System — REST API (Node.js, Express, MySQL, Sequelize)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node init-db.js",
    "db:migrate": "node src/migrations/run.js",
    "worker:reminders": "node src/workers/appointmentReminderWorker.js",
    "test": "node test/run-tests.js",
    "test:reminders:mysql": "node test/run-appointmentReminder.mysql.integration.js",
    "test:config": "node --test test/config.security.unit.test.js",
    "lint": "eslint src"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.0",
    "sequelize": "^6.37.3",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
